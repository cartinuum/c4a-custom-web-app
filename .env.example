# npm run dev / preview use HTTPS (self-signed). Open https://localhost:5173 — accept the browser warning once.
# Override ArcGIS portal (optional). Query param ?portal=https://your.portal.com takes precedence at runtime.
VITE_ARCGIS_PORTAL=https://my-org.maps.arcgis.com

# Optional defaults (also overridable in code)
VITE_WEBMAP_ITEM_ID=9bcb26a....

